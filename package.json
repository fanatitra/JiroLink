{
  "name": "jirolink-backend",
  "version": "0.1.0",
  "private": true,
  "description": "JiroLink - classes de domaine et schéma de persistance",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.cjs",
    "demo": "tsx src/demo.ts",
    "vecteurs:token": "tsx scripts/generer-vecteurs-token.ts",
    "start": "node --env-file=.env dist/main.js",
    "db:up": "docker compose up -d",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:validate": "prisma validate",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "dev": "tsc -p tsconfig.json && node --env-file=.env dist/main.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "multer": "^2.5.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
