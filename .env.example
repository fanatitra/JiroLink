# Copier en .env puis REMPLIR chaque valeur. Les valeurs vides font échouer le démarrage volontairement.
DATABASE_URL="postgresql://jirolink:jirolink@localhost:5432/jirolink?schema=public"
PORT=3000

# 32 caractères minimum, aléatoire :   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Clé racine des tokens de recharge : 64 caractères hexadécimaux (32 octets), même commande que ci-dessus.
# Elle ne quitte JAMAIS le serveur ; chaque compteur reçoit uniquement sa clé dérivée.
TOKEN_ROOT_KEY=

# Secret pour hacher les codes de recharge en base (16 caractères minimum)
TOKEN_PEPPER=

# Utilisés uniquement par `npm run db:seed` (aucun mot de passe par défaut n'existe)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
